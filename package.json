{
  "name": "three-render",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node scripts/run-tests.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/three-render/",
    "preview": "vite preview",
    "preview:pages": "vite preview --base=/three-render/",
    "assets:generate": "node scripts/generate-public-assets.mjs",
    "check:public": "node scripts/check-public-release.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.2",
    "three": "^0.180.0",
    "three-gpu-pathtracer": "^0.0.24",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "description": "A local-first browser 3D scene editor with physical materials and path-traced rendering.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ntvibe/three-render.git"
  },
  "bugs": {
    "url": "https://github.com/ntvibe/three-render/issues"
  },
  "homepage": "https://github.com/ntvibe/three-render#readme"
}
